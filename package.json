{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "laravel-message-preview",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -b && vite build",
    "dev": "vite",
    "fix": "oxlint --fix --fix-dangerously --fix-suggestions --tsconfig tsconfig.json",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint --tsconfig tsconfig.json"
  },
  "dependencies": {
    "@gravity-ui/icons": "^2.23.0",
    "@heroui/react": "^3.2.7",
    "@heroui/styles": "^3.2.7",
    "@shikijs/langs": "^4.6.0",
    "@shikijs/themes": "^4.6.0",
    "@tanstack/react-hotkeys": "^0.20.1",
    "@tanstack/react-query": "^5.105.0",
    "@xstate/store": "^4.3.0",
    "@xstate/store-react": "^2.1.0",
    "axe-core": "^4.14.0",
    "filesize": "^11.0.29",
    "nanoid": "^6.0.2",
    "nuqs": "^2.10.2",
    "pluralize": "^8.0.0",
    "react": "^19.3.1",
    "react-aria-components": "^1.22.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.16.1",
    "shiki": "^4.6.0"
  },
  "devDependencies": {
    "@babel/core": "^8.0.10",
    "@rolldown/plugin-babel": "^0.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.6",
    "@types/pluralize": "^0.0.33",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "babel-plugin-react-compiler": "^1.0.0",
    "laravel-vite-plugin": "^3.2.0",
    "oxfmt": "^0.75.0",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "^7.0.2005",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "nub",
      "version": "0.9.7",
      "onFail": "ignore"
    }
