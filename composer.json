{
    "name": "hosmelq/laravel-message-preview",
    "description": "Preview Laravel mailables and mail notifications in the browser.",
    "license": "MIT",
    "keywords": [
        "developer-tools",
        "email",
        "email-preview",
        "laravel",
        "laravel-mail",
        "laravel-mail-preview",
        "laravel-message-preview",
        "laravel-notifications",
        "mail",
        "mail-preview",
        "mailable",
        "notifications",
        "php",
        "preview"
    ],
    "authors": [
        {
            "name": "Hosmel Quintana",
            "email": "hosmelq@gmail.com"
        }
    ],
    "homepage": "https://hosmelq.com/docs/laravel-message-preview",
    "support": {
        "docs": "https://hosmelq.com/docs/laravel-message-preview"
    },
    "require": {
        "php": "^8.4",
        "ext-dom": "*",
        "composer/class-map-generator": "^1.9.0",
        "guzzlehttp/psr7": "^2.13.0 || ^3.5.0",
        "hosmelq/caniemail": "^1.1.1",
        "laravel/framework": "^13.42.0",
        "psr/http-message": "^1.1 || ^2.0",
        "spatie/laravel-package-tools": "^1.93.3",
        "thecodingmachine/safe": "^3.4.0"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.57.0",
        "hosmelq/php-coding-standard": "^1.5.0",
        "larastan/larastan": "^3.15.0",
        "orchestra/testbench": "^11.3.0",
        "pestphp/pest": "^5.3.6",
        "pestphp/pest-plugin-agent": "^5.0.0",
        "pestphp/pest-plugin-rector": "^5.0.6",
        "shipmonk/composer-dependency-analyser": "^1.8.4"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "HosmelQ\\MessagePreview\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HosmelQ\\MessagePreview\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "HosmelQ\\MessagePreview\\MessagePreviewServiceProvider"
            ]
        }
    },
    "scripts": {
        "ecs": "ecs check --fix",
        "phpstan": "phpstan analyse --memory-limit=4G",
        "rector": "rector",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/testbench workbench:build --ansi",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "test": "pest",
        "test-coverage": "pest --coverage"
    },
    "scripts-descriptions": {
        "ecs": "Runs ECS.",
        "phpstan": "Runs PHPStan analyse.",
        "rector": "Runs Rector.",
        "serve": "Builds and serves the Workbench application.",
        "test": "Runs the Pest test suite.",
        "test-coverage": "Runs the Pest test suite with code coverage."
    },
    "$schema": "https://getcomposer.org/schema.json"
}
