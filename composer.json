{
    "name": "hosmelq/laravel-message-preview",
    "description": "Preview Laravel mailables and mail notifications in the browser.",
    "license": "MIT",
    "keywords": [
        "developer-tools",
        "email",
        "email-preview",
        "hosmelq",
        "laravel",
        "laravel-mail",
        "laravel-mail-preview",
        "laravel-message-preview",
        "laravel-notifications",
        "mail",
        "mail-preview",
        "mailable",
        "notifications",
        "php",
        "preview"
    ],
    "authors": [
        {
            "name": "Hosmel Quintana",
            "email": "hosmelq@gmail.com"
        }
    ],
    "homepage": "https://hosmelq.com/docs/laravel-message-preview",
    "support": {
        "docs": "https://hosmelq.com/docs/laravel-message-preview"
    },
    "require": {
        "php": "^8.4",
        "ext-dom": "*",
        "composer/class-map-generator": "^1.7",
        "guzzlehttp/psr7": "^2.9 || ^3.0",
        "hosmelq/caniemail": "^1.1",
        "laravel/framework": "^12.0 || ^13.0",
        "psr/http-message": "^1.1 || ^2.0",
        "spatie/laravel-package-tools": "^1.93",
        "thecodingmachine/safe": "^3.4"
    },
    "require-dev": {
        "ergebnis/composer-normalize": "^2.54",
        "hosmelq/php-coding-standard": "^1.4",
        "larastan/larastan": "^3.13",
        "laravel/pao": "^1.1",
        "orchestra/testbench": "^10.0 || ^11.3",
        "pestphp/pest": "^4.7 || ^5.3",
        "shipmonk/composer-dependency-analyser": "^1.8"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "HosmelQ\\MessagePreview\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "HosmelQ\\MessagePreview\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/"
        }
    },
    "config": {
        "allow-plugins": {
            "ergebnis/composer-normalize": true,
            "pestphp/pest-plugin": true,
            "phpstan/extension-installer": true
        },
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "providers": [
                "HosmelQ\\MessagePreview\\MessagePreviewServiceProvider"
            ]
        }
    },
    "scripts": {
        "ecs": "ecs check --fix=true",
        "ecs:check": "ecs check",
        "phpstan": "phpstan analyse --configuration=phpstan.neon.dist --memory-limit=4G",
        "rector": "rector",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/testbench workbench:build --ansi",
            "@php vendor/bin/testbench serve --ansi"
        ],
        "test": "pest",
        "test-coverage": "pest --coverage"
    },
    "scripts-descriptions": {
        "ecs": "Format PHP code using the shared ECS set.",
        "ecs:check": "Check PHP formatting using the shared ECS set.",
        "phpstan": "Run PHPStan static analysis.",
        "rector": "Run Rector automated refactoring.",
        "serve": "Build and serve the local Workbench application.",
        "test": "Run the test suite using Pest.",
        "test-coverage": "Run the test suite with code coverage using Pest."
    },
    "$schema": "https://getcomposer.org/schema.json"
}
